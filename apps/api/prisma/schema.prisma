generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum HealthRecordType {
  VACCINATION
  MEDICAL_CHECKUP
  TREATMENT
  SURGERY
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ActivityType {
  WALK
  PLAY
  FEEDING
  GROOMING
  TRAINING
  OTHER
}

enum NotificationType {
  MEDICATION
  APPOINTMENT
  CLINIC
}

enum ClinicRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum MedicationFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  AS_NEEDED
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  fullName               String                  @db.VarChar(120)
  email                  String                  @unique @db.VarChar(320)
  passwordHash           String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  pets                   Pet[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Pet {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  species       String         @db.VarChar(80)
  breed         String?        @db.VarChar(120)
  dateOfBirth   DateTime?      @db.Date
  gender        Gender         @default(UNKNOWN)
  weight        Float?
  medicalNotes  String?
  ownerId       String         @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]
  appointments  Appointment[]
  medications   Medication[]
  activities    Activity[]
  photos        PetPhoto[]
  notifications Notification[]
  clinicLink    ClinicLink?

  @@index([ownerId])
  @@index([ownerId, name])
}

model HealthRecord {
  id               String           @id @default(uuid()) @db.Uuid
  petId            String           @db.Uuid
  recordType       HealthRecordType
  title            String           @db.VarChar(150)
  description      String?
  recordDate       DateTime         @db.Date
  veterinarianName String?          @db.VarChar(150)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  pet              Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, recordDate])
}

model Appointment {
  id              String                    @id @default(uuid()) @db.Uuid
  petId           String                    @db.Uuid
  appointmentDate DateTime
  providerName    String                    @db.VarChar(150)
  reason          String                    @db.VarChar(200)
  notes           String?
  status          AppointmentStatus         @default(SCHEDULED)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  pet             Pet                       @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinicRequest   ClinicAppointmentRequest?

  @@index([petId])
  @@index([appointmentDate, status])
}

model Medication {
  id           String              @id @default(uuid()) @db.Uuid
  petId        String              @db.Uuid
  name         String              @db.VarChar(120)
  dosage       String              @db.VarChar(80)
  frequency    MedicationFrequency
  timesOfDay   String[]            @default([])
  startDate    DateTime            @db.Date
  endDate      DateTime?           @db.Date
  instructions String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  pet          Pet                 @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, isActive])
}

model Activity {
  id              String       @id @default(uuid()) @db.Uuid
  petId           String       @db.Uuid
  activityType    ActivityType
  activityDate    DateTime
  durationMinutes Int?
  distanceKm      Float?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  pet             Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, activityDate])
}

model PetPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  petId     String   @db.Uuid
  caption   String?  @db.VarChar(200)
  width     Int
  height    Int
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, createdAt])
}

model NotificationPreference {
  userId               String   @id @db.Uuid
  timeZone             String   @db.VarChar(64)
  medicationReminders  Boolean  @default(true)
  appointmentReminders Boolean  @default(true)
  appointmentLeadHours Int      @default(24)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  petId     String?          @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  message   String           @db.VarChar(500)
  dueAt     DateTime
  dedupeKey String           @db.VarChar(200)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet       Pet?             @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, dueAt])
}

model ClinicLink {
  id              String    @id @default(uuid()) @db.Uuid
  petId           String    @unique @db.Uuid
  clinicId        String    @db.VarChar(50)
  linkedAt        DateTime  @default(now())
  lastSharedAt    DateTime?
  lastSharedCount Int       @default(0)
  pet             Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model ClinicAppointmentRequest {
  id                String              @id @default(uuid()) @db.Uuid
  appointmentId     String              @unique @db.Uuid
  clinicId          String              @db.VarChar(50)
  externalReference String              @db.VarChar(80)
  status            ClinicRequestStatus
  message           String?             @db.VarChar(300)
  submittedAt       DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  appointment       Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}
